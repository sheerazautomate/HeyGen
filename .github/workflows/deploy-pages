name: Deploy site to GitHub Pages

# Publishes the site/ folder (the composition studio + video gallery) to
# GitHub Pages, and injects this repo's coordinates into site/config.js so
# visitors don't have to type owner/repo. Also bundles examples/ into the
# site so the "Load example" button works from Pages.

on:
  push:
    branches: [main]
    paths:
      - "site/**"
      - "examples/**"
      - ".github/workflows/deploy-pages.yml"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Prepare site bundle
        run: |
          set -euo pipefail
          OWNER="${GITHUB_REPOSITORY_OWNER}"
          REPO="${GITHUB_REPOSITORY#"${OWNER}"/}"
          mkdir -p site/examples
          cp examples/*.html site/examples/ 2>/dev/null || true
          cat > site/config.js <<EOF
          // Auto-generated by deploy-pages.yml — the repo this site was deployed from.
          // Values are only defaults; visitors can override them in the UI.
          window.SITE_CONFIG = { owner: "${OWNER}", repo: "${REPO}" };
          EOF
          echo "Deploying ${OWNER}/${REPO} — site files:"
          find site -type f | sort

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
